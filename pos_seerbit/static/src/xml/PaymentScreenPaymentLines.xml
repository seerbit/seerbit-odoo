<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_seerbit.PaymentScreenPaymentLinesInherited" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension">
        <xpath expr="//t[div[@class='electronic_status' and contains(., 'Request sent')]]/div[2]" position="inside">
            <div t-if="['waiting', 'waitingCard', 'waitingCapture'].includes(line.payment_status)" class="button send_payment_request_resend highlight text-bg-primary" role="button" title="Resend Payment Request" t-on-click="() => this.props.sendPaymentRequest(line)">
                Resend
            </div>
        </xpath>
    </t>

</templates>