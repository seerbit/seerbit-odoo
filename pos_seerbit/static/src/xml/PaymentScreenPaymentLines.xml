<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentLine" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-line-info')]" position="after">
            <t t-if="props.paymentline.payment_method.use_payment_terminal === 'seerbit'">
                <t t-if="props.paymentline.payment_status === 'waiting'">
                    <div class="electronic_status waiting" aria-live="polite">
                        <span class="seerbit-icon" aria-hidden="true">
                            <i class="fa fa-hourglass-half"/>
                        </span>
                        <span>Waiting</span>
                    </div>
                    <!-- Force Confirm button for 'waiting' state -->
                    <div class="button send_force_done dangerous" title="Force Done" aria-label="Force Confirm"
                        t-on-click="() => this.env.services.pos.force_seerbit_payment_done(props.paymentline)">
                        <i class="fa fa-bolt seerbit-icon" aria-hidden="true"/> Force Confirm
                    </div>
                    <!-- Retry button (less common in 'waiting' unless it's a specific 'pending' retry) -->
                    <!-- Removed for 'waiting' state as it's typically for 'error/failed' -->
                </t>
                <t t-if="props.paymentline.payment_status === 'failed' || props.paymentline.payment_status === 'errorSeerbit'">
                    <div class="electronic_status error" aria-live="polite">
                        <span class="seerbit-icon" aria-hidden="true">
                            <i class="fa fa-exclamation-triangle"/>
                        </span>
                        <span>Error</span>
                    </div>
                    <!-- Force Confirm button for 'error/failed' state -->
                    <div class="button send_force_done dangerous" title="Force Done" aria-label="Force Confirm"
                        t-on-click="() => this.env.services.pos.force_seerbit_payment_done(props.paymentline)">
                        <i class="fa fa-bolt seerbit-icon" aria-hidden="true"/> Force Confirm
                    </div>
                    <!-- Retry button for 'error/failed' state -->
                    <div class="button send_payment_request highlight" title="Send Payment Request" aria-label="Retry Payment Request"
                        t-on-click="() => this.env.services.pos.retry_seerbit_payment_request(props.paymentline)">
                        <i class="fa fa-redo seerbit-icon" aria-hidden="true"/> Retry
                    </div>
                </t>
                <t t-if="props.paymentline.payment_status === 'doneSeerbit' || props.paymentline.payment_status === 'done'">
                     <div class="electronic_status done" aria-live="polite">
                        <span class="seerbit-icon" aria-hidden="true">
                            <i class="fa fa-check"/>
                        </span>
                        <span>Processed</span>
                    </div>
                </t>
            </t>
        </xpath>
    </t>
</templates>
