<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="SeerbitPaymentScreenPaymentLines" t-inherit="point_of_sale.PaymentScreenPaymentLines" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('electronic_payment')]" position="inside">
            <div style="background:#ffeedd;color:#a13e00;padding:8px;margin-bottom:8px;border-radius:6px;font-weight:bold;">
                [Seerbit] PaymentScreenPaymentLines extension loaded
            </div>
            <t t-if="line.payment_status == 'waitingSeerbit'">
                <div class="electronic_status waiting" aria-live="polite">
                    <span class="seerbit-icon" aria-hidden="true">
                        <i class="fa fa-hourglass-half"/> <!-- FontAwesome waiting icon -->
                    </span>
                    <span>Waiting</span>
                </div>
                <div class="button send_force_done dangerous" title="Force Done" aria-label="Force Confirm" t-on-click="() => this.trigger('send-force-done', line)">
                    <i class="fa fa-bolt seerbit-icon" aria-hidden="true"/> Force Confirm
                </div>
                <div class="button send_payment_request highlight" title="Send Payment Request" aria-label="Retry Payment Request" t-on-click="() => this.trigger('send-payment-request', line)">
                    <i class="fa fa-redo seerbit-icon" aria-hidden="true"/> Retry
                </div>
            </t>
            <t t-else="line.payment_status == 'errorSeerbit'">
                <div class="electronic_status error" aria-live="polite">
                    <span class="seerbit-icon" aria-hidden="true">
                        <i class="fa fa-exclamation-triangle"/> <!-- FontAwesome error icon -->
                    </span>
                    <span>Error</span>
                </div>
                <div class="button send_force_done dangerous" title="Force Done" aria-label="Force Confirm" t-on-click="() => this.trigger('send-force-done', line)">
                    <i class="fa fa-bolt seerbit-icon" aria-hidden="true"/> Force Confirm
                </div>
                <div class="button send_payment_request highlight" title="Send Payment Request" aria-label="Retry Payment Request" t-on-click="() => this.trigger('send-payment-request', line)">
                    <i class="fa fa-redo seerbit-icon" aria-hidden="true"/> Retry
                </div>
            </t>
        </xpath>
    </t>
</templates>