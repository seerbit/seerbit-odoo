<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="SeerbitTerminalInterface" owl="1">
        <div class="seerbit-terminal-interface">
            <div class="terminal-header">
                <h3>Seerbit Payment Terminal</h3>
                <div class="payment-amount">
                    Amount: <span t-esc="this.formatCurrency(this.paymentAmount)"/>
                </div>
            </div>

            <div class="terminal-status" t-if="this.state.message">
                <div class="status-message" t-attf-class="status-#{this.state.status}">
                    <span t-esc="this.state.message"/>
                </div>
            </div>

            <div class="terminal-actions">
                <!-- Send Payment Request Button -->
                <button 
                    class="btn btn-primary send-payment-btn" 
                    t-on-click="this.sendPaymentRequest"
                    t-att-disabled="this.state.isProcessing or not this.isSeerbitPayment"
                    t-if="this.state.status === 'ready' or this.state.status === 'error'">
                    <i class="fa fa-paper-plane"/> Send Payment Request
                </button>

                <!-- Processing State -->
                <div class="processing-state" t-if="this.state.status === 'processing'">
                    <i class="fa fa-spinner fa-spin"/> Processing...
                </div>

                <!-- Success State -->
                <div class="success-state" t-if="this.state.status === 'success'">
                    <i class="fa fa-check-circle"/> Payment Request Sent
                </div>

                <!-- Force Confirm Button -->
                <button 
                    class="btn btn-warning force-confirm-btn" 
                    t-on-click="this.forceConfirm"
                    t-if="this.state.status === 'error' or this.state.status === 'success'">
                    <i class="fa fa-bolt"/> Force Confirm
                </button>

                <!-- Retry Button -->
                <button 
                    class="btn btn-secondary retry-btn" 
                    t-on-click="this.retryPayment"
                    t-if="this.state.status === 'error'">
                    <i class="fa fa-redo"/> Retry
                </button>
            </div>

            <div class="terminal-instructions">
                <p><strong>Instructions:</strong></p>
                <ol>
                    <li>Click "Send Payment Request" to initiate the payment</li>
                    <li>Complete the payment on your Seerbit terminal</li>
                    <li>Wait for confirmation or use "Force Confirm" if payment was made</li>
                </ol>
            </div>
        </div>
    </t>
</templates> 