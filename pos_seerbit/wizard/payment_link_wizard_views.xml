<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_link_wizard_form_seerbit" model="ir.ui.view">
        <field name="name">payment.link.wizard.form.seerbit</field>
        <field name="model">payment.link.wizard</field>
        <field name="inherit_id" ref="payment.payment_link_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='payment_info']" position="inside">
                <field name="generate_seerbit_link" invisible="res_model != 'account.move'"/>
                <field name="seerbit_link_name" invisible="not generate_seerbit_link"/>
                <field name="seerbit_link_url" widget="CopyClipboardChar" invisible="not seerbit_link_url"/>
            </xpath>
            <xpath expr="//footer/field[@name='link']" position="attributes">
                <attribute name="invisible">generate_seerbit_link</attribute>
            </xpath>
            <xpath expr="//footer/field[@name='link']" position="before">
                <button name="action_generate_seerbit_link" 
                        type="object" 
                        string="Generate Seerbit Link" 
                        class="btn-primary" 
                        invisible="not generate_seerbit_link or seerbit_link_url"/>
            </xpath>
        </field>
    </record>
</odoo>
